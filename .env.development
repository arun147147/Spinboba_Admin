# Local backend. The shared Node/Express server listens on 3000.
VITE_API_URL=http://localhost:5000

# ============================================================
# ADMIN API KEY
#
# Must equal ADMIN_API_KEY in SERVER/.env, or every store
# write comes back 401.
#
# NOTE: this ships in the admin bundle, so anyone who can
# load the admin app can read it. That is inherent to a
# shared secret with no login endpoint - it is a gate that
# keeps the store endpoints off the open internet, not an
# identity system. Replace both sides with a real admin
# login when there is one.
# ============================================================
VITE_ADMIN_API_KEY=xexJhEqR6LP8oja5gG8mQQoBE2PIncFoDczFWoLVgwQ
